# 鱼小二 配置示例：复制为 .env 后按需修改
# 只保留真实原生通道；没有账号时界面为空，扫码后开始同步。

# ---- 应用 ----
YUXIAOER_PORT=8787
# 邮件确认链接的地址；手机点链接时改成局域网 IP（需服务监听 0.0.0.0 或反代）
# YUXIAOER_PUBLIC_URL=http://192.168.1.10:8787
# 邮件确认链接签名密钥；默认复用外部接口 secret
# YUXIAOER_EMAIL_SECRET=change-me
# YUXIAOER_DATA_DIR=D:\yuxiaoer\data
# ---- 多账号（一账号一实例）----
# YUXIAOER_ACCOUNT_ID=acct_2
# YUXIAOER_ACCOUNTS_DIR=D:\yuxiaoer\data\shops
# 非默认账号的数据目录，一般不用改；不要用全局 YUXIAOER_DATA_DIR 覆盖多账号
# YUXIAOER_ACCOUNT_DATA_DIR=D:\yuxiaoer\data\shops\acct_2
# 兼容旧变量：YUXIAOER_SHOP_ID / YUXIAOER_SHOPS_DIR / YUXIAOER_SHOP_DATA_DIR
# 控制台 Basic Auth（可选；暴露到局域网/公网时强烈建议设置）
# YUXIAOER_CONSOLE_USER=owner
# YUXIAOER_CONSOLE_PASSWORD=change-me

# ---- 多账号控制台 ----
# 控制台端口（run-control.ps1 也可用 -Port 覆盖）
# YUXIAOER_CONTROL_PORT=8790
# 启动时是否自动拉起注册表里 auto_start 的账号（1/0）
# YUXIAOER_CONTROL_AUTOSTART=1
# 注册表/日志目录，默认 data/control
# YUXIAOER_CONTROL_DIR=D:\yuxiaoer\data\control

# ---- 原生闲鱼协议（真实扫码/WS/订单同步）----
XY_APP_KEY=34839810
XY_WS_URL=wss://wss-goofish.dingtalk.com/
XY_ORDER_SYNC_SECONDS=60
# 可选：高德 Web 服务 Key；不配时按内置城市坐标兜底
AMAP_KEY=

# ---- 外部真实数据接口 /api/v1/external/* ----
# 生产必须改成强随机值；默认值只适合本机
YUXIAOER_EXTERNAL_SECRET=yx-local-secret

# ---- LLM（可选；OpenAI 兼容端点）----
LLM_ENABLED=off
LLM_API_KEY=
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
LLM_MODEL=glm-4.6
LLM_TIMEOUT=20
LLM_COOLDOWN_SECONDS=300

# ---- 值守/护栏 ----
# 回复频控（条/分钟）；逐条回复模式下默认 12，平台风险自负
YUXIAOER_REPLY_RATE_LIMIT=12
# 工具步数上限目前是服务端硬编码

# ---- 企业微信 / 多渠道通知（可选；也可在控制台「通知渠道」页添加）----
WECOM_WEBHOOK=
BARK_URL=
SERVERCHAN_KEY=
NTFY_URL=
NTFY_TOPIC=yuxiaoer
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
PUSHPLUS_TOKEN=
GOTIFY_URL=
GOTIFY_TOKEN=

# ---- 账号信息 ----
YUXIAOER_SHOP_NAME=我的闲鱼账号
YUXIAOER_OWNER_NAME=我
