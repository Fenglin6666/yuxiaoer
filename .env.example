# 鱼小二 配置示例：复制为 .env 后按需修改
# 只保留真实原生通道；没有账号时界面为空，扫码后开始同步。

# ---- 应用 ----
YUXIAOER_PORT=8787
# 邮件确认链接的地址；手机点链接时改成局域网 IP（需服务监听 0.0.0.0 或反代）
# YUXIAOER_PUBLIC_URL=http://192.168.1.10:8787
# 邮件确认链接签名密钥；默认复用外部接口 secret
# YUXIAOER_EMAIL_SECRET=change-me
# YUXIAOER_DATA_DIR=D:\yuxiaoer\data
# 控制台 Basic Auth（可选；暴露到局域网/公网时强烈建议设置）
# YUXIAOER_CONSOLE_USER=owner
# YUXIAOER_CONSOLE_PASSWORD=change-me

# ---- 原生闲鱼协议（真实扫码/WS/订单同步）----
XY_APP_KEY=34839810
XY_WS_URL=wss://wss-goofish.dingtalk.com/
XY_ORDER_SYNC_SECONDS=60
# 可选：高德 Web 服务 Key；不配时按内置城市坐标兜底
AMAP_KEY=

# ---- 外部真实数据接口 /api/v1/external/* ----
# 生产必须改成强随机值；默认值只适合本机
YUXIAOER_EXTERNAL_SECRET=yx-local-secret

# ---- LLM（可选；OpenAI 兼容端点）----
LLM_ENABLED=off
LLM_API_KEY=
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
LLM_MODEL=glm-4.6
LLM_TIMEOUT=20
LLM_COOLDOWN_SECONDS=300

# ---- 值守/护栏 ----
MERGE_WINDOW_SECONDS=1.5
# 连续消息不断重置合并窗口时的最大等待（秒）；防止首条消息被无限期压住
MERGE_MAX_SECONDS=6
# 生产建议 5 秒；本机 1.5 秒
# 频控 2 条/分钟与工具步数上限目前是服务端硬编码

# ---- 企业微信 / 多渠道通知（可选；也可在控制台「通知渠道」页添加）----
WECOM_WEBHOOK=
BARK_URL=
SERVERCHAN_KEY=
NTFY_URL=
NTFY_TOPIC=yuxiaoer
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
PUSHPLUS_TOKEN=
GOTIFY_URL=
GOTIFY_TOKEN=

# ---- 店铺信息 ----
YUXIAOER_SHOP_NAME=我的闲鱼小店
YUXIAOER_OWNER_NAME=店主
